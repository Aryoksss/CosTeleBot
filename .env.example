BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
XAPIVERSE_KEY=YOUR_XAPIVERSE_API_KEY_HERE

# Opsional: Telegram Bot API Server lokal (mengangkat limit upload 48MB -> 2GB).
# LOCAL_API_URL=http://127.0.0.1:8081

# Opsional: CSV admin IDs (boleh multiple). Default: 6663343995
# ADMIN_IDS=6663343995,1234567890

# Opsional: CSV password arsip kustom. Akan dicoba sebelum default list.
# Default sudah termasuk: cosplaytele.com, Cosplaytele.com, cosplaytele, Cosplaytele, 4KHD, 4khd
# ARCHIVE_PASSWORDS=mypass1,mypass2

# Opsional: proxy HTTP(S) global — dipakai sebagai fallback oleh Gofile & Pinterest
# kalau GOFILE_PROXY/PINTEREST_PROXY tidak di-set. Format: http://user:pass@host:port
# HTTPS_PROXY=http://127.0.0.1:8080

# Opsional: Proxy khusus untuk Pinterest (bypass rate-limit / geo-block).
# Fallback berurutan: PINTEREST_PROXY -> GOFILE_PROXY -> HTTPS_PROXY.
# PINTEREST_PROXY=socks5://127.0.0.1:40000

# Opsional: Proxy khusus untuk Gofile (bypass IP banned datacenter).
# Cara paling gampang: install Cloudflare WARP di VPS dalam proxy mode.
#   warp-cli mode proxy && warp-cli connect
# Default WARP proxy port: SOCKS5 127.0.0.1:40000
# GOFILE_PROXY=socks5://127.0.0.1:40000
#
# PENTING soal limit Gofile guest: akun guest dibatasi 1000GB/30hari per IP.
# WARP pakai exit-IP yang dishare jutaan user → kuota guest sering SUDAH HABIS
# (error "Monthly download limit exceeded 1000GB"). Solusi:
#   1. (TERBAIK) Pakai token akun Gofile sendiri di GOFILE_TOKEN bawah ini.
#      Login gofile.io → My Profile → salin "API Token". Premium = tanpa limit.
#   2. Atau pakai proxy berbayar/residential (bukan WARP yang shared).
# Kalau pakai GOFILE_TOKEN, biasanya GOFILE_PROXY/WARP tidak perlu lagi.
# GOFILE_TOKEN=your-gofile-account-api-token

# Opsional: Smart-Search via Groq LLM (Llama-3.3 70B, 14.4k req/hari gratis).
# Register di https://console.groq.com → API Keys → Create.
# Kalau kosong, bot fallback ke regex trigger (tetap jalan, cuma kurang fleksibel).
# GROQ_API_KEY=gsk_xxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile
# Mode asisten interaktif: kalau pesan bukan pencarian, bot balas ngobrol & arahkan
# ke command (default AKTIF kalau GROQ_API_KEY ada). Set 0 untuk matikan.
# GROQ_CHAT_REPLY=1

# Opsional: DeepSeek sebagai FALLBACK AI (OpenAI-compatible). Dipakai otomatis kalau
# Groq tidak ada key / kena rate-limit / circuit-breaker aktif. Daftar di https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# Model: deepseek-v4-flash (cepat & murah, cocok untuk bot) atau deepseek-v4-pro (lebih pintar, lebih mahal).
# DEEPSEEK_MODEL=deepseek-v4-flash
# Urutan provider AI (CSV). Default: groq dulu, lalu deepseek.
# AI_PROVIDER_ORDER=groq,deepseek

# Opsional: Tuning antrean download.
# Sesuaikan dengan spec VPS kamu. Setiap job aktif konsumsi ~200-300 MB RAM peak
# (download + extract + compress + upload).
#   1 GB RAM VPS: QUEUE_CONCURRENCY=2-3
#   2 GB RAM VPS: QUEUE_CONCURRENCY=4-5
#   4 GB RAM VPS: QUEUE_CONCURRENCY=6-8  (default 6)
#   8 GB RAM VPS: QUEUE_CONCURRENCY=10-12
# Default: maxConcurrency=6, maxPerUser=8
# QUEUE_CONCURRENCY=6
# QUEUE_MAX_PER_USER=8

# Opsional: Web Dashboard (admin monitoring via browser).
# Kalau kedua env ini di-set, bot bind port 3000 dan serve dashboard di http://127.0.0.1:3000/admin
# dengan HTTP Basic Auth. Kalau kosong, dashboard OFF (tidak bind port).
# DASHBOARD_USER=admin
# DASHBOARD_PASS=supersecret
# DASHBOARD_PORT=3000
# DASHBOARD_HOST=127.0.0.1   # default localhost, ubah ke 0.0.0.0 kalau mau public (pakai nginx/caddy reverse proxy)

# Opsional: Browser Reaper — bunuh proses Chromium (Playwright) zombie yang nyangkut.
# Default: bunuh proses browser >5 menit, sapuan tiap 5 menit (Linux only).
# BROWSER_REAP_MINUTES=5
# BROWSER_REAP_INTERVAL=5

# Opsional: Auto-split video yang melebihi limit upload Telegram jadi beberapa part
# pakai ffmpeg (-c copy, tanpa re-encode). Butuh ffmpeg+ffprobe terpasang di VPS:
#   sudo apt install -y ffmpeg
# Set 0 untuk matikan (file oversize akan dilewati seperti sebelumnya).
# SPLIT_OVERSIZE=1

# Opsional: Faststart remux video sebelum dikirim — moov atom dipindah ke depan supaya
# video bisa di-stream/preview di Telegram tanpa download penuh (seperti Javtiful).
# Default AKTIF untuk video <= FASTSTART_MAX_MB (butuh ffmpeg). Set 0 untuk matikan.
#   FASTSTART=1
#   FASTSTART_MAX_MB=500   # remux dilewati untuk file lebih besar (boros I/O)

# Opsional: Anime scraper domain (kalau domain berubah, update di sini).
# Otakudesu sering ganti domain — support CSV multiple domain (fallback kiri ke kanan).
# Kalau domain pertama timeout/error, otomatis coba domain berikutnya.
# OTAKUDESU_DOMAINS=https://otakudesu.fit,https://otakudesu.cloud,https://otakudesu.la,https://otakudesu.ro
# Oploverz backend API (biasanya stabil).
# OPLOVERZ_API_BASE=https://backapi.oploverz.ac/api
# Kusonime base domain (kalau domain utama pindah, update di sini).
# KUSONIME_DOMAIN=https://kusonime.com

# Opsional: 4KHD (KHD) tuning — batas foto per album & concurrency download album.
# KHD_MAX_PHOTOS=80         # cap jumlah foto yang diproses per album (hindari timeout)
# KHD_DL_CONCURRENCY=8      # unduhan paralel per album

# Opsional: Terabox ndus cookie — supaya API /share/list mengembalikan direct link (dlink).
# Ambil nilai ndus dari browser (login terabox.com -> DevTools -> Application -> Cookies).
# Bisa berupa token polos, "ndus=xxxx", atau JSON {"ndus":"xxxx"}.
# TERABOX_COOKIE=xxxxx
# COOKIE_JSON={"ndus":"xxxxx"}   # alias/format alternatif, dipakai kalau TERABOX_COOKIE kosong

# Opsional: Mega.nz login untuk bypass anonymous quota limit.
# Anonymous download shared global quota per-IP dari semua user Mega — sering kena limit cepat.
# Dengan login akun, quota jadi per-akun (20 GB/bulan di free tier, 2TB kalau Pro).
# Daftar gratis di https://mega.nz — cukup bikin 1 akun buat bot.
# MEGA_EMAIL=your@email.com
# MEGA_PASSWORD=your-mega-password
# Opsional: Proxy khusus untuk Mega (bypass IP throttle datacenter).
# Kalau MEGA_PROXY tidak di-set, otomatis pakai GOFILE_PROXY (WARP).
# MEGA_PROXY=socks5://127.0.0.1:40000


# Opsional: SoraFolder decryption passphrase (AES).
# Hanya perlu diubah kalau SoraFolder mengganti kunci enkripsinya.
# SORAFOLDER_KEY=Ak7qrvvH4WKYxV2OgaeHAEg2a5eh16vE

# Opsional: chat tujuan notifikasi deploy & health-check (default: ADMIN_IDS pertama).
# DEPLOY_NOTIFY_CHAT=123456789

# Supabase Service Role Key — untuk push notification ke aplikasi Galeri.
# Dapatkan dari: Supabase Dashboard → Project Settings → API → service_role key
# SUPABASE_SERVICE_KEY=eyJhbGci...

# Opsional: override URL Supabase Edge Function push-notification.
# Default sudah terisi hardcode. Ganti kalau project Supabase kamu beda.
# SUPABASE_NOTIF_URL=https://<project-ref>.supabase.co/functions/v1/push-notification

# Opsional: Auto-Notify Watcher — kabari ADMIN saat ada post/episode baru (polling).
# Notif hanya dikirim ke ADMIN_IDS. Sumber default: javtiful, otakudesu.
# (cosplaytele sengaja TIDAK di-watch karena update-nya sangat sering / spam.
#  Tambahkan "cosplaytele" ke WATCHER_SOURCES kalau memang mau dipantau.)
# WATCHER_ENABLED=1
# WATCHER_INTERVAL_MIN=15
# WATCHER_SOURCES=javtiful,otakudesu
# WATCHER_MAX_NOTIFY=5
# WATCHER_SEEN_LIMIT=300
# WATCHER_DIGEST=1              # 1 = kumpulkan post baru jadi 1 pesan (anti-spam), 0 = kirim satu-satu

# Opsional: interval checker subscription (follow aktris/cosplayer) dalam menit (min 10, default 20).
# SUBS_INTERVAL_MIN=20

# Opsional: Premium via Crypto Pay (CryptoBot). Chat @CryptoBot → Crypto Pay → Create App → API Token.
# Tanpa token ini fitur premium berbayar nonaktif (admin tetap bisa /grant manual).
# CRYPTOPAY_TOKEN=12345:AAxxxxxxxx
# CRYPTOPAY_ASSET=USDT          # aset tagihan (USDT/TON/BTC/dll), default USDT
# CRYPTOPAY_TESTNET=0           # 1 = pakai @CryptoTestnetBot untuk uji coba

# Opsional: limit antrean untuk user PREMIUM (default 20, vs QUEUE_MAX_PER_USER untuk free).
# QUEUE_MAX_PER_USER_PREMIUM=20

# Opsional: kuota DOWNLOAD per hari per tier (admin unlimited). Default Free 3 / Premium 15 / VVIP 50.
# LIMIT_FREE=3
# LIMIT_PREMIUM=15
# LIMIT_VVIP=50
