BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
XAPIVERSE_KEY=YOUR_XAPIVERSE_API_KEY_HERE

# Opsional: Telegram Bot API Server lokal (mengangkat limit upload 48MB -> 2GB).
# LOCAL_API_URL=http://127.0.0.1:8081

# Opsional: CSV admin IDs (boleh multiple). Default: 6663343995
# ADMIN_IDS=6663343995,1234567890

# Opsional: CSV password arsip kustom. Akan dicoba sebelum default list.
# Default sudah termasuk: cosplaytele.com, Cosplaytele.com, cosplaytele, Cosplaytele, 4KHD, 4khd
# ARCHIVE_PASSWORDS=mypass1,mypass2

# Opsional: Proxy khusus untuk Gofile (bypass IP banned datacenter).
# Cara paling gampang: install Cloudflare WARP di VPS dalam proxy mode.
#   warp-cli mode proxy && warp-cli connect
# Default WARP proxy port: SOCKS5 127.0.0.1:40000
# GOFILE_PROXY=socks5://127.0.0.1:40000

# Opsional: Smart-Search via Groq LLM (Llama-3.3 70B, 14.4k req/hari gratis).
# Register di https://console.groq.com → API Keys → Create.
# Kalau kosong, bot fallback ke regex trigger (tetap jalan, cuma kurang fleksibel).
# GROQ_API_KEY=gsk_xxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile

# Opsional: Tuning antrean download.
# Sesuaikan dengan spec VPS kamu. Setiap job aktif konsumsi ~200-300 MB RAM peak
# (download + extract + compress + upload).
#   1 GB RAM VPS: QUEUE_CONCURRENCY=2-3
#   2 GB RAM VPS: QUEUE_CONCURRENCY=4-5
#   4 GB RAM VPS: QUEUE_CONCURRENCY=6-8  (default 6)
#   8 GB RAM VPS: QUEUE_CONCURRENCY=10-12
# Default: maxConcurrency=6, maxPerUser=8
# QUEUE_CONCURRENCY=6
# QUEUE_MAX_PER_USER=8

# Opsional: Web Dashboard (admin monitoring via browser).
# Kalau kedua env ini di-set, bot bind port 3000 dan serve dashboard di http://127.0.0.1:3000/admin
# dengan HTTP Basic Auth. Kalau kosong, dashboard OFF (tidak bind port).
# DASHBOARD_USER=admin
# DASHBOARD_PASS=supersecret
# DASHBOARD_PORT=3000
# DASHBOARD_HOST=127.0.0.1   # default localhost, ubah ke 0.0.0.0 kalau mau public (pakai nginx/caddy reverse proxy)

# Opsional: Anime scraper domain (kalau domain berubah, update di sini).
# Otakudesu sering ganti domain (.fit, .la, .cloud, .ro, .id).
# OTAKUDESU_DOMAIN=https://otakudesu.fit
# Oploverz backend API (biasanya stabil).
# OPLOVERZ_API_BASE=https://backapi.oploverz.ac/api
